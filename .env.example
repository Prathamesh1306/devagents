# ─── LLM Provider (Default: Local Ollama — zero configuration required) ────
LLM_PROVIDER=ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1

# ─── Optional Cloud Providers (uncomment to override) ──────────────────────
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-flash-latest

# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4o

# ─── Infrastructure Configuration ──────────────────────────────────────────
POSTGRES_USER=devagents
POSTGRES_PASSWORD=devagents_pass
POSTGRES_DB=devagents_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://devagents:devagents_pass@postgres:5432/devagents_db

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

API_HOST=0.0.0.0
API_PORT=8000
